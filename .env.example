# Study OS – Server-Konfiguration (optional)
# Lokal: Kopiere diese Datei nach ".env" und trage deine Werte ein (.env wird nie zu GitHub hochgeladen).
# Vercel: Trage dieselben Namen unter Project → Settings → Environment Variables ein – NICHT in den Code.
# Niemals ein VITE_-Präfix für Schlüssel verwenden: VITE_-Variablen landen im Browser (der Build bricht dann ab).
# Ohne KI-Schlüssel funktionieren alle Lernfunktionen trotzdem – nur Tutor & KI-Generierung sind aus.
# Schlüssel bleiben auf dem Server und werden NIE an den Browser geschickt.

# auto | anthropic | openai | openai-compatible | none
AI_PROVIDER=auto

# --- Anthropic (Claude) – API-Schlüssel von https://console.anthropic.com (kostenpflichtig nach Verbrauch;
#     ein Claude-Pro-Abo enthält KEINE API-Nutzung) ---
ANTHROPIC_API_KEY=
# Standard: claude-opus-5-5. Alternativ z. B. claude-sonnet-5-5 oder claude-haiku-5-5 (günstiger).
ANTHROPIC_MODEL=claude-opus-5-5
# Server-seitiger Ausweich-Mechanismus bei abgelehnten Anfragen (nur für unterstützte Modelle). "off" schaltet ihn ab.
ANTHROPIC_FALLBACKS=on

# --- OpenAI oder OpenAI-kompatibel (z. B. Ollama, LM Studio) ---
OPENAI_API_KEY=
# Genauer Modellname deines Anbieters – Study OS rät keine Modellnamen.
OPENAI_MODEL=
# Für Ollama: http://localhost:11434/v1  (dann AI_PROVIDER=openai-compatible, Schlüssel kann leer bleiben)
OPENAI_BASE_URL=
# Kann das Modell Bilder lesen (für Arbeitsblatt-Fotos)? true/false
OPENAI_SUPPORTS_IMAGES=false

# --- Server (nur für npm start; auf Vercel ignoriert) ---
PORT=8787
# Zugangscode, wenn der Server im Netzwerk/Internet erreichbar ist (wird in der App unter Einstellungen > KI eingetragen).
# Auf Vercel PFLICHT, sobald ein KI-Schlüssel gesetzt ist – sonst bleibt die KI gesperrt, damit Fremde
# nicht auf deine Kosten den Tutor benutzen. Mindestens 16 zufällige Zeichen.
APP_ACCESS_TOKEN=
# Höchstzahl KI-Anfragen pro Minute und Gerät (auf Vercel pro Server-Instanz, also nur ein grober Schutz)
AI_RATE_LIMIT_PER_MIN=20
# Nur wenn die Web-App von einer anderen Adresse geladen wird, z. B. https://meine-app.example
ALLOWED_ORIGINS=
# Nur für selbst gehostete, öffentlich erreichbare Server: "true" sperrt die KI ohne APP_ACCESS_TOKEN (wie auf Vercel).
STUDYOS_PUBLIC=false

# --- Google-Anmeldung & Synchronisierung (Supabase) ---
# Öffentliche Werte (dürfen in den Browser; geschützt durch Row Level Security). Die Vercel-Supabase-Integration
# legt sie meist automatisch an (SUPABASE_URL, SUPABASE_ANON_KEY bzw. NEXT_PUBLIC_…). Study OS liest alle Varianten.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# NIE hier oder als VITE_-Variable eintragen: SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY / SUPABASE_JWT_SECRET.
# Study OS braucht diese geheimen Schlüssel nicht; der Server verweigert sie als öffentliche Konfiguration.
